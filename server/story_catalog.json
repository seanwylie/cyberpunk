 "contacts": {
  "odalys_vane": {
   "name": "Odalys Vane",
   "role": "fixer",
   "bio": "Sells Annex contracts out of a tarp stall. Keeps three ledgers and shows nobody the third."
  },
  "tech_marr": {
   "name": "Marr",
   "role": "technician",
   "bio": "Reads replacement-part markings the way others read faces. Will not say who taught them."
  },
  "handler_cole": {
   "name": "Cole",
   "role": "handler",
   "bio": "Kestrel Value Systems asset recovery. Tracks controllers and refurbishments that went missing after resale."
  },
  "ten_hallowell": {
   "name": "Teodor \"Ten\" Hallowell",
   "role": "fixer",
   "bio": "Retired Line 7 shift lead turned fixer. Still hears the shift horn. Sells foundry contracts to anyone with force hardware."
  },
  "noor_abiodun": {
   "name": "Noor Abiodun",
   "role": "fixer",
   "bio": "Street clinician who patches contractors for free and sells Ward 9 leads for a price. Keeps her own scars unrepaired."
  },
  "pell_okafor": {
   "name": "Pell Okafor",
   "role": "trader",
   "bio": "Resells everything twice. Trades in salvage, hardware and rumours, and believes the three are the same product."
  },
  "ilya_sen": {
   "name": "Ilya Sen",
   "role": "technician",
   "bio": "Ceramics technician who left Aldane with three fingers of calibration notes. Reads Aldane weave patterns by touch."
  },
  "liaison_costa": {
   "name": "Dr. Mireille Costa",
   "role": "handler",
   "bio": "Aldane Surgical compliance liaison. Writes the audit commands the Annex terminals obey and denies writing them."
  },
  "liaison_dunmore": {
   "name": "Rhea Dunmore",
   "role": "handler",
   "bio": "Harrow-Brandt reclaim liaison. Counts everything that leaves a Harrow facility, including the people."
  }
