{
  "name": "wv-infra",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK app for Warranty Void (client hosting, game server on ECS Fargate, story Lambda). Nothing here deploys itself.",
  "scripts": {
    "build": "tsc --noEmit",
    "synth": "cdk synth",
    "test": "node --test --import tsx test/*.test.ts",
    "diff": "cdk diff",
    "deploy": "cdk deploy --all",
    "deploy-story": "cdk deploy WvStory --exclusively",
    "diff-story": "cdk diff WvStory --exclusively"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "aws-cdk": "^2.170.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2"
  }
}
