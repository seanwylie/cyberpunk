# Copy to .env (never commit). Story proxy (server-side only; never exposed to the client bundle):
OPENAI_API_KEY=
# optional: small/fast chat model for story beats (default gpt-5.4-nano)
OPENAI_STORY_MODEL=
# optional: set to 1 when behind a trusted proxy/CDN so per-IP limits use X-Forwarded-For
STORY_TRUST_PROXY=
# optional: max upstream story calls per UTC day (default 3000)
STORY_DAILY_CAP=
